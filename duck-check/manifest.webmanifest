{
  "name": "Duck Check",
  "short_name": "Duck Check",
  "description": "Papa Duck: share a screenshot, get buy or pass.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#1F3A5F",
  "theme_color": "#1F3A5F",
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any maskable" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable" }
  ],
  "share_target": {
    "action": "/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [{ "name": "image", "accept": ["image/*"] }]
    }
  }
}
